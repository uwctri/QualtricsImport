{
    "name": "Qualtrics Import",
    "namespace": "UWMadison\\QualtricsImport",
    "description": "Automated ingestion, deduplication, automatic date/phone sanitization, and record creation from Qualtrics survey screening responses into REDCap.",
    "authors": [
        {
            "name": "Adam Nunez",
            "email": "adam.Nunez@ctri.wisc.edu",
            "institution": "UW Madison - Center for Tobacco Research and Intervention"
        }
    ],
    "framework-version": 17,
    "links": {
        "project": [
            {
                "name": "Qualtrics Import",
                "icon": "fas fa-cloud-download-alt",
                "url": "pages/import.php",
                "show-header-and-footer": true
            }
        ]
    },
    "auth-ajax-actions": [
        "getSurveys",
        "testConnection",
        "previewImport",
        "runImport"
    ],
    "crons": [
        {
            "cron_name": "qualtrics_import_sync",
            "cron_description": "Recurring background synchronization of survey responses from Qualtrics into configured REDCap projects",
            "method": "cronQualtricsImport",
            "cron_frequency": "3600",
            "cron_max_run_time": "1800"
        }
    ],
    "system-settings": [
        {
            "key": "qualtrics_api_token",
            "name": "Global Qualtrics API Token",
            "type": "text"
        },
        {
            "key": "qualtrics_data_center",
            "name": "Global Qualtrics Data Center (e.g., uwmadison.co1)",
            "type": "text"
        },
        {
            "key": "allow_project_overrides",
            "name": "Allow Individual Projects to Override Global Qualtrics Credentials",
            "type": "checkbox"
        }
    ],
    "project-settings": [
        {
            "key": "source_header",
            "name": "<strong>Qualtrics Connection & Survey Settings</strong>",
            "type": "descriptive"
        },
        {
            "key": "override_credentials",
            "name": "Override Global Qualtrics Credentials for this Project",
            "type": "checkbox"
        },
        {
            "key": "project_qualtrics_api_token",
            "name": "Project Qualtrics API Token",
            "type": "text",
            "branchingLogic": {
                "field": "override_credentials",
                "value": "1"
            }
        },
        {
            "key": "project_qualtrics_data_center",
            "name": "Project Qualtrics Data Center (e.g., uwmadison.co1)",
            "type": "text",
            "branchingLogic": {
                "field": "override_credentials",
                "value": "1"
            }
        },
        {
            "key": "qualtrics_survey_id",
            "name": "Qualtrics Survey ID (e.g., SV_8CfudJDsw3LwsyG)",
            "type": "text",
            "required": true
        },
        {
            "key": "import_enabled",
            "name": "Enable Automated Background Scheduled Imports",
            "type": "checkbox"
        },
        {
            "key": "sync_frequency",
            "name": "Scheduled Sync Frequency",
            "type": "dropdown",
            "choices": [
                { "value": "900", "name": "Every 15 minutes" },
                { "value": "3600", "name": "Hourly" },
                { "value": "86400", "name": "Daily" }
            ],
            "default": "3600",
            "branchingLogic": {
                "field": "import_enabled",
                "value": "1"
            }
        },
        {
            "key": "permissions_header",
            "name": "<strong>Access Permissions</strong>",
            "type": "descriptive"
        },
        {
            "key": "link_display_permission",
            "name": "Who can access and run manual imports from the project menu?",
            "type": "dropdown",
            "choices": [
                { "value": "all", "name": "All project users (Default)" },
                { "value": "data_import_tool", "name": "Users with Data Import Tool rights (or Design rights)" },
                { "value": "record_create", "name": "Users with Record Create rights (or Design rights)" },
                { "value": "design", "name": "Users with Project Design and Setup rights only" },
                { "value": "custom_users", "name": "Specific selected users only" }
            ],
            "default": "all"
        },
        {
            "key": "allowed_users",
            "name": "Authorized Users",
            "type": "user-list",
            "repeatable": true,
            "branchingLogic": {
                "field": "link_display_permission",
                "value": "custom_users"
            }
        },
        {
            "key": "target_header",
            "name": "<strong>REDCap Target & Identifier Strategy</strong>",
            "type": "descriptive"
        },
        {
            "key": "record_id_strategy",
            "name": "Record ID Generation Strategy",
            "type": "dropdown",
            "choices": [
                { "value": "seed_increment", "name": "Incremental Seed ID (Recommended - max numeric ID + 1)" },
                { "value": "autonumber", "name": "REDCap Native Auto-Numbering" },
                { "value": "qualtrics_response_id", "name": "Qualtrics ResponseId directly" }
            ],
            "default": "seed_increment"
        },
        {
            "key": "min_seed_id",
            "name": "Minimum Seed ID",
            "type": "text",
            "default": "1000",
            "branchingLogic": {
                "field": "record_id_strategy",
                "value": "seed_increment"
            }
        },
        {
            "key": "target_event",
            "name": "Target Event",
            "type": "event-list"
        },
        {
            "key": "qualtrics_id_field",
            "name": "REDCap Field to store Qualtrics ResponseId",
            "type": "field-list",
            "default": "qualtrics_id",
            "branchingLogic": {
                "field": "record_id_strategy",
                "op": "!=",
                "value": "qualtrics_response_id"
            }
        },
        {
            "key": "dedup_header",
            "name": "<strong>Deduplication & Screening Rules</strong>",
            "type": "descriptive"
        },
        {
            "key": "dedup_phone_field",
            "name": "Primary Phone Field",
            "type": "field-list",
            "default": "phone1",
            "required": true
        },
        {
            "key": "dedup_first_name_field",
            "name": "First Name Field",
            "type": "field-list",
            "default": "first_name",
            "required": true
        },
        {
            "key": "dedup_last_name_field",
            "name": "Last Name Field",
            "type": "field-list",
            "default": "last_name",
            "required": true
        },
        {
            "key": "import_notes_field",
            "name": "Import Notes Field (for duplicate warnings and shared phone notices)",
            "type": "field-list"
        },
        {
            "key": "mapping_header",
            "name": "<strong>Field Mapping & Transformation</strong>",
            "type": "descriptive"
        },
        {
            "key": "auto_populated_fields_blurb",
            "name": "<div class='alert alert-info' style='margin-bottom:0; font-size:12px; font-weight:normal; line-height:1.5;'><strong>Auto-Populated Fields:</strong><br>If these variables exist in your REDCap project, they are automatically populated during import:<ul><li><code>display_name</code> &ndash; Concatenated respondent name (<code>[first_name] [last_name]</code>).</li><li><code>import_date</code> &amp; <code>first_import_date</code> &ndash; Current date of import (<code>YYYY-MM-DD</code>).</li><li><code>qualtrics_id</code> &ndash; The Qualtrics ResponseId (e.g. <code>R_...</code>).</li></ul><strong>Special Formatting for Static Field Defaults:</strong><br>Under <em>Static Field Defaults / Import Flags</em> below, you can populate any REDCap field with special dynamic keywords:<ul><li><code>today</code> &ndash; Inserts today's date in <code>YYYY-MM-DD</code> format.</li><li><code>now</code> &ndash; Inserts the current timestamp in <code>YYYY-MM-DD HH:MM:SS</code> format.</li><li>Static numbers or text (e.g., <code>1</code> for an import flag checkbox/radio).</li></ul></div>",
            "type": "descriptive"
        },
        {
            "key": "mapping_mode",
            "name": "Field Mapping Mode",
            "type": "dropdown",
            "choices": [
                { "value": "auto_map_blacklist", "name": "Auto-Map Matching Fields (skips metadata and blacklisted fields)" },
                { "value": "whitelist", "name": "Whitelist Mode (only import fields explicitly specified below)" }
            ],
            "default": "auto_map_blacklist"
        },
        {
            "key": "only_completed",
            "name": "Only import completed responses",
            "type": "checkbox"
        },
        {
            "key": "skip_fields",
            "name": "Blacklist (comma-separated Qualtrics field names to ignore)",
            "type": "text"
        },
        {
            "key": "required_fields",
            "name": "Required REDCap Fields (comma-separated; candidate skipped if any of these are empty)",
            "type": "text",
            "default": "phone1,first_name,last_name"
        },
        {
            "key": "filter_logic",
            "name": "Optional Filter Logic (e.g., [screen_score] = '0')",
            "type": "text"
        },
        {
            "key": "custom_value_mappings",
            "name": "Custom Choice / Value Mappings",
            "type": "sub_settings",
            "repeatable": true,
            "sub_settings": [
                {
                    "key": "qualtrics_field",
                    "name": "Qualtrics Field Name",
                    "type": "text"
                },
                {
                    "key": "redcap_field",
                    "name": "Target REDCap Field",
                    "type": "field-list"
                },
                {
                    "key": "value_map_json",
                    "name": "Value Mapping JSON (e.g., {\"1\": \"0\", \"2\": \"1\"})",
                    "type": "text"
                }
            ]

        },
        {
            "key": "static_field_defaults",
            "name": "Static Field Defaults / Import Flags<br><span class='text-muted' style='font-weight:normal; font-size:11px;'>Set static values (e.g., '1') or dynamic keywords (<code>today</code>, <code>now</code>).</span>",
            "type": "sub_settings",
            "repeatable": true,
            "sub_settings": [
                {
                    "key": "field_name",
                    "name": "Target REDCap Field",
                    "type": "field-list"
                },
                {
                    "key": "field_value",
                    "name": "Static Value / Keyword (e.g., '1', 'today', 'now')",
                    "type": "text"
                }
            ]
        },
        {
            "key": "similarity_thresholds_header",
            "name": "<strong>Similarity Thresholds</strong><br><span class='text-muted' style='font-weight:normal;'>These control fuzzy name matching between survey submissions and existing records. They typically do not need to be changed.</span>",
            "type": "descriptive"
        },
        {
            "key": "case2_last_sim",
            "name": "Same Phone: Last Name Match Threshold (0.0 to 1.0)",
            "type": "text",
            "default": "0.85"
        },
        {
            "key": "case2_first_sim",
            "name": "Same Phone: First Name Match Threshold (0.0 to 1.0)",
            "type": "text",
            "default": "0.80"
        },
        {
            "key": "case4_last_sim",
            "name": "Different Phone: Last Name Match Threshold (0.0 to 1.0)",
            "type": "text",
            "default": "0.95"
        },
        {
            "key": "case4_first_sim",
            "name": "Different Phone: First Name Match Threshold (0.0 to 1.0)",
            "type": "text",
            "default": "0.90"
        }
    ]
}
